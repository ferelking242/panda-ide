{
  "name": "panda-extension-host-tests",
  "version": "1.0.0",
  "description": "Jest tests for Panda IDE Extension Host API shim",
  "private": true,
  "scripts": {
    "test": "jest --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/*.test.js"],
    "collectCoverageFrom": [
      "../../assets/extension_host/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "moduleNameMapper": {
      "^../ipc\\.js$": "<rootDir>/mocks/ipc.js",
      "^./ipc\\.js$": "<rootDir>/mocks/ipc.js",
      "^../types\\.js$": "<rootDir>/../../assets/extension_host/api/types.js"
    }
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}

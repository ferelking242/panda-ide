<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LaunchTheme: black background so the native splash matches Flutter splash seamlessly -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- NormalTheme: applied once Flutter engine draws its first frame -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>

    <!-- Workaround for PlayCore transparent overlay service -->
    <style name="Theme.PlayCore.Transparent" parent="@android:style/Theme.Translucent.NoTitleBar" />
</resources>
